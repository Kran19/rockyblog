generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  AUTHOR
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  permissions   String[]
  slug          String?
  bio           String?    @db.Text
  designation   String?
  coverImage    String?
  socialLinks   Json?
  expertise     String[]   @default([])
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  media         Media[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

model Post {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  content         String      @db.Text
  excerpt         String?     @db.Text
  featuredImage   String?
  featuredImageAlt String?
  playImage       String?
  playImageAlt    String?
  status          PostStatus  @default(DRAFT)
  adminRemarks    String?     @db.Text
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  redirectEnabled Boolean    @default(false)
  redirectUrl     String?
  redirectDelay   Int        @default(3)
  metaPixelId     String?
  scheduledAt     DateTime?
  viewCount       Int         @default(0)
  inSitemap       Boolean    @default(true)
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  categories      Category[]
  tags            Tag[]
  comments        Comment[]
  likes           Like[]
  bookmarks       Bookmark[]
  visitors        BlogVisitor[]
  clicks          BlogClick[]
  redirectLogs    BlogRedirectLog[]
  auditLogs       BlogAuditLog[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  posts       Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Comment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  postId     String
  authorId   String
  parentId   String?
  isApproved Boolean   @default(false)
  post       Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  createdAt  DateTime  @default(now())
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Media {
  id           String   @id @default(cuid())
  url          String
  altText      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Subscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  status    SubscriberStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GlobalSettings {
  id              String   @id @default("global")
  siteName        String   @default("stock-247.com")
  seoTitle        String?
  seoDescription  String?  @db.Text
  seoKeywords     String?
  updatedAt       DateTime @updatedAt
}

model BlogVisitor {
  id               String   @id @default(cuid())
  postId           String
  post             Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorId        String
  ipAddress        String?
  country          String?
  state            String?
  city             String?
  browser          String?
  os               String?
  device           String?
  screenResolution String?
  language         String?
  timezone         String?
  userAgent        String?  @db.Text
  referrer         String?  @db.Text
  landingPage      String?
  visitedAt        DateTime @default(now())
  exitTime         DateTime?
  sessionDuration  Int      @default(0) // seconds
  sessionId        String
  isUnique         Boolean  @default(true)
  isReturning      Boolean  @default(false)
  userId           String?

  @@index([postId, visitedAt])
  @@index([sessionId])
  @@index([visitorId])
}

model BlogClick {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  blogTitle    String
  clickedUrl   String   @db.Text
  clickedAt    DateTime @default(now())
  ipAddress    String?
  country      String?
  state        String?
  city         String?
  browser      String?
  os           String?
  device       String?
  userAgent    String?  @db.Text
  referrer     String?  @db.Text
  sessionId    String?
  visitorId    String?
  userId       String?
  ctaButton    String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?

  @@index([postId, clickedAt])
  @@index([sessionId])
}

model BlogSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  visitorId   String
  startTime   DateTime @default(now())
  endTime     DateTime?
  duration    Int      @default(0) // in seconds
  landingPage String?
  exitPage    String?

  @@index([sessionId])
  @@index([visitorId])
}

model BlogRedirectLog {
  id           String   @id @default(cuid())
  postId       String
  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  clickedUrl   String   @db.Text
  redirectedTo String   @db.Text
  isSuccessful Boolean  @default(true)
  timestamp    DateTime @default(now())
  ipAddress    String?
  userAgent    String?  @db.Text

  @@index([postId, timestamp])
}

model BlogAuditLog {
  id        String   @id @default(cuid())
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  action    String
  userId    String
  userEmail String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  timestamp DateTime @default(now())
  ipAddress String?

  @@index([timestamp])
}

